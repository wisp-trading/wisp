# Strategy config.yml template
# Place next to main.go: strategies/<name>/config.yml
#
# Lists exchanges/assets only — never secrets.
# Domain (spot/perp/…) = connector MarketType for each exchange.
# Keys: wisp → Settings → ~/.wisp/connectors.yml

name: starter
description: Standalone strategy (main.go + StartStandalone + Wait)
exchanges:
  - hyperliquid
assets:
  hyperliquid:
    - base: BTC
      quote: USD
parameters:
  dry_run: true
