# Connector settings example (same shape as ~/.wisp/connectors.yml).
# Preferred: wisp → Settings (writes ~/.wisp/connectors.yml).
# Optional project-local copy as wisp.yml only for migration/testing.
connectors:
  - name: hyperliquid
    enabled: false
    network: mainnet
    credentials:
      private_key: ""
      account_address: ""
